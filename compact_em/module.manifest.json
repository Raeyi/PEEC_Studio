{
  "manifestVersion": 1,
  "id": "compact_em",
  "name": "Compact_EM",
  "version": "2026.11.10-v1.4",
  "apiVersion": 4,
  "cli": {
    "executables": [
      "PEEC_Model_Extractor.exe",
      "PEEC_Solver.exe",
      "PEEC_Post_Processing.exe"
    ],
    "dataRootArg": "--data-root"
  },
  "stages": [
    {
      "id": "extract",
      "executable": "PEEC_Model_Extractor.exe",
      "argsTemplate": [
        "--data-root",
        "{dataRoot}",
        "--runtime-dir",
        "{runtimeDir}",
        "--export",
        "model"
      ],
      "allowedArgs": [
        "--export"
      ],
      "exitCodes": {
        "0": "ok",
        "1": "failure",
        "2": "unhandled_exception"
      },
      "errorContract": {
        "type": "none"
      },
      "consumesInternal": [],
      "producesInternal": [
        "compact_em/extract.model"
      ]
    },
    {
      "id": "solve",
      "executable": "PEEC_Solver.exe",
      "argsTemplate": [
        "--data-root",
        "{dataRoot}",
        "--runtime-dir",
        "{runtimeDir}",
        "--export",
        "csv"
      ],
      "allowedArgs": [
        "--export",
        "--accuracy",
        "--workers",
        "--mkl-threads"
      ],
      "exitCodes": {
        "0": "ok",
        "1": "failure"
      },
      "errorContract": {
        "type": "none"
      },
      "consumesInternal": [
        "compact_em/extract.model"
      ],
      "producesInternal": [
        "compact_em/solve.response",
        "compact_em/solve.post"
      ]
    },
    {
      "id": "post",
      "executable": "PEEC_Post_Processing.exe",
      "optional": true,
      "argsTemplate": [
        "--data-root",
        "{dataRoot}",
        "--runtime-dir",
        "{runtimeDir}",
        "--export",
        "post"
      ],
      "allowedArgs": [
        "--export"
      ],
      "exitCodes": {
        "0": "ok",
        "1": "failure",
        "2": "invalid_cli"
      },
      "errorContract": {
        "type": "none"
      },
      "consumesInternal": [
        "compact_em/extract.model",
        "compact_em/solve.post"
      ],
      "producesInternal": []
    }
  ],
  "artifacts": {
    "produced": [
      {
        "ref": "compact_em/model.peec",
        "path": "Result/compact_em/extract/model.peec",
        "schemaVersion": "2"
      },
      {
        "ref": "compact_em/sp.csv",
        "path": "Result/compact_em/solve/S_parameter.csv",
        "schemaVersion": "1"
      },
      {
        "ref": "compact_em/y.csv",
        "path": "Result/compact_em/solve/Y_parameter.csv",
        "schemaVersion": "1"
      },
      {
        "ref": "compact_em/z.csv",
        "path": "Result/compact_em/solve/Z_parameter.csv",
        "schemaVersion": "1"
      }
    ],
    "consumed": [
      {
        "ref": "gds2geo/mesh.em",
        "path": "Model/model_em.msh",
        "accept": {
          "extensions": [
            ".msh"
          ]
        }
      },
      {
        "ref": "gds2geo/matdb.model",
        "path": "Model/matdb.json",
        "accept": {
          "schemaVersion": {
            "min": 3,
            "max": 3
          }
        }
      },
      {
        "ref": "em/source.def",
        "path": "Model/source_em.json",
        "accept": {
          "fields": [
            "meshFile",
            "meshSha256",
            "ports"
          ]
        }
      },
      {
        "ref": "user/solver.set",
        "path": "Setting/set_em.json",
        "accept": {
          "schemaVersion": {
            "min": 1,
            "max": 1
          }
        }
      }
    ]
  },
  "dependsOn": {
    "artifacts": [
      "gds2geo/mesh.em",
      "gds2geo/matdb.model",
      "em/source.def",
      "user/solver.set"
    ]
  },
  "capabilities": {
    "dataLayout": "peec-data/v1",
    "dataLayoutRevision": "1.6",
    "physics": "Lossless surface PEC in vacuum, optional infinite horizontal PEC ground",
    "publicExports": [
      "FreeSpace PEECFS02 model.peec",
      "S/Y/Z CSV"
    ],
    "postFileExports": "Configured source/field files are listed in the stage receipt; no automatic host artifact/UI routes are declared for them.",
    "stageReceipts": "v1, best effort; integrity state remains mandatory",
    "modelFormat": {
      "magic": "PEECFS02",
      "version": 2,
      "binaryCompatibleWithCompact": false
    },
    "breakingChanges": [
      {
        "version": "2026.11.09-model-peec-v2",
        "note": "API 2 replaces API 1 model.state text/loose matrix outputs with direct public extract/model.peec. New production writes no bin/txt artifacts, including private/staging files. Standard SAVE_BIN/SAVE_TXT are rejected by presence; legacy controls warn as deprecated. Geometry/topology are in the package; source snapshots, model/stage states and standard context are structured JSON."
      },
      {
        "version": "2026.11.10-v1.4",
        "note": "Compact_EM identity with the FreeSpace PEC/vacuum implementation. API 4 replaces legacy Compact PEECPK01/schema1 with FreeSpace PEECFS02/version2 and model schema2. Re-extract models; old Compact model files are not binary compatible. Provider output/log/receipt identity is compact_em. The S CSV reference remains compact_em/sp.csv; Y/Z are optional additions. Existing FreeSpace stderr behavior is declared as errorContract none."
      },
      {
        "version": "2026.11.10-v1.4",
        "revisionId": "merged-post-20261111",
        "note": "Same-version revision requested by the user: retain Compact_EM v1.4/API4. Post outputs are Source.msh and Field.msh with _real/_imag/_mag views. Split paths are no longer produced; use revisionId and package SHA-256 to identify this output arrangement. Numerical code, executable bytes, model PEECFS02/version2 and public model/S/Y/Z artifacts are unchanged."
      }
    ]
  }
}
