{
  "manifestVersion": 1,
  "id": "compact_em",
  "name": "Compact EM 电磁求解链",
  "version": "2026.11.04-v1.3",
  "apiVersion": 3,
  "minApiVersion": 1,
  "cli": {
    "executables": [
      "PEEC_Model_Extractor.exe",
      "PEEC_Solver.exe",
      "PEEC_Post_Processing.exe"
    ],
    "dataRootArg": "--data-root",
    "deprecatedModes": [
      "legacy-set-txt"
    ]
  },
  "stages": [
    {
      "id": "extract",
      "executable": "PEEC_Model_Extractor.exe",
      "argsTemplate": [
        "--data-root",
        "{dataRoot}",
        "--runtime-dir",
        "{runtimeDir}",
        "--export",
        "post,report"
      ],
      "optional": false,
      "allowedArgs": [
        "--export"
      ],
      "exitCodes": {
        "0": "ok",
        "1": "failure",
        "2": "unhandled_exception"
      },
      "errorContract": {
        "type": "qs-json-stderr",
        "traceLog": "Result/logs/compact_em/Model_Extractor-{trace_id}.jsonl"
      },
      "consumesInternal": [],
      "producesInternal": [
        "compact_em/extract.model",
        "compact_em/extract.post"
      ]
    },
    {
      "id": "solve",
      "executable": "PEEC_Solver.exe",
      "argsTemplate": [
        "--data-root",
        "{dataRoot}",
        "--runtime-dir",
        "{runtimeDir}",
        "--export",
        "post"
      ],
      "optional": false,
      "allowedArgs": [
        "--export",
        "--s-columns",
        "--post-freq-index",
        "--post-port"
      ],
      "exitCodes": {
        "0": "ok",
        "1": "failure"
      },
      "errorContract": {
        "type": "qs-json-stderr",
        "traceLog": "Result/logs/compact_em/Solver-{trace_id}.jsonl"
      },
      "consumesInternal": [
        "compact_em/extract.model"
      ],
      "producesInternal": [
        "compact_em/solve.response",
        "compact_em/solve.post"
      ]
    },
    {
      "id": "post",
      "executable": "PEEC_Post_Processing.exe",
      "argsTemplate": [
        "--data-root",
        "{dataRoot}",
        "--runtime-dir",
        "{runtimeDir}",
        "--source-plots",
        "j,qe,ve",
        "--parts",
        "mag"
      ],
      "optional": true,
      "allowedArgs": [
        "--source-plots",
        "--field-plots",
        "--parts"
      ],
      "exitCodes": {
        "0": "ok",
        "1": "failure"
      },
      "errorContract": {
        "type": "qs-json-stderr",
        "traceLog": "Result/logs/compact_em/Post_Processing-{trace_id}.jsonl"
      },
      "consumesInternal": [
        "compact_em/extract.post",
        "compact_em/solve.post"
      ],
      "producesInternal": []
    }
  ],
  "artifacts": {
    "produced": [
      {
        "ref": "compact_em/model.peec",
        "path": "Result/compact_em/extract/model.peec",
        "schemaVersion": "1"
      },
      {
        "ref": "compact_em/sp.csv",
        "path": "Result/compact_em/solve/S_parameter.csv",
        "schemaVersion": "1"
      }
    ],
    "consumed": [
      {
        "ref": "gds2geo/mesh.em",
        "path": "Model/model_em.msh",
        "accept": {
          "extensions": [
            ".msh"
          ]
        }
      },
      {
        "ref": "gds2geo/matdb.model",
        "path": "Model/matdb.json",
        "accept": {
          "schemaVersion": {
            "min": 3,
            "max": 3
          }
        }
      },
      {
        "ref": "em/source.def",
        "path": "Model/source_em.json",
        "maintainedBy": [
          "ui"
        ],
        "accept": {
          "fields": [
            "meshFile",
            "meshSha256",
            "ports"
          ]
        }
      },
      {
        "ref": "user/solver.set",
        "path": "Setting/set_em.json",
        "accept": {
          "schemaVersion": {
            "min": 1,
            "max": 1
          }
        }
      }
    ]
  },
  "dependsOn": {
    "modules": [
      "gds2geo"
    ],
    "artifacts": [
      "gds2geo/mesh.em",
      "gds2geo/matdb.model",
      "em/source.def",
      "user/solver.set"
    ]
  },
  "capabilities": {
    "dataLayout": "peec-data/v1",
    "breakingChanges": [
      {
        "version": "2026.10.30",
        "note": "API 2: explicit dataRoot; per-stage output paths; port_em.json; flat set.json; optional receipts separated from mandatory internal artifact integrity."
      },
      {
        "version": "2026.11.02",
        "note": "DATA_LAYOUT v1.2: Model/source_em.json replaces port_em.json; em/source.def replaces em/ports.def; defaultTemplate removed; examples and settings are delivered in a separate case package."
      },
      {
        "version": "2026.11.04-v1.3",
        "note": "API 3 / DATA_LAYOUT v1.4 revision 1 EM requirements: Setting/set_em.json is the only accepted JSON settings name; deprecated set.txt remains supported with a warning. Old set.json artifact indexes are stale. The delivered stages/executables are extract, solve and post; the S-parameter Plotter and all Touchstone sNp exports (including legacy implicit export) are removed. Missing selected settings now report QS-FMT-SETTING-INVALID. The module directory contains only three executables, manifest, README and ERROR_CODES; schemas, technical notes and inventories are delivered outside it. This batch also includes the existing 2026-11-04 mainline PEC reference ground, real-system/memory optimizations and low-frequency full-charge accuracy fixes; differences from the 2026-11-02 numerical baseline are documented separately."
      }
    ],
    "dataLayoutRevision": "1.3"
  }
}
