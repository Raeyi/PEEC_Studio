{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Compact flat set.json V1",
  "description": "Flat settings for peec-data/v1. Unknown keys are ignored. Numeric strings retain their exact decimal token; integer representability, bounds and cross-field conditions are also checked by the runtime. No defaults are added by conversion.",
  "type": "object",
  "required": ["schemaVersion", "DIM", "FS", "FE"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "DIM": {"$ref": "#/definitions/positive"},
    "FS": {"$ref": "#/definitions/frequency"},
    "FE": {"$ref": "#/definitions/frequency"},
    "N_FP": {"$ref": "#/definitions/positiveInt32"},
    "PRECISION": {"$ref": "#/definitions/nonnegative"},
    "Swap_Log": {"$ref": "#/definitions/switch"},
    "Taylor": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 10}, {"$ref": "#/definitions/numericToken"}]},
    "SAVE_BIN": {"$ref": "#/definitions/switch"},
    "SAVE_TXT": {"$ref": "#/definitions/switch"},
    "SAVE_SP": {"$ref": "#/definitions/switch"},
    "Solver_SET": {"anyOf": [{"type": "integer", "const": 0}, {"$ref": "#/definitions/numericToken"}]},
    "MNA_WEIGHT": {"$ref": "#/definitions/positive"},
    "SOLVER_MEMORY_MB": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 1000000000}, {"$ref": "#/definitions/numericToken"}]},
    "SOLVER_THREADS": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 4096}, {"$ref": "#/definitions/numericToken"}]},
    "POST_PROCESSING": {"$ref": "#/definitions/switch"},
    "POST_FREQ_INDEX": {"anyOf": [{"type": "integer", "const": -1}, {"$ref": "#/definitions/positiveInt32"}]},
    "POST_PORT": {"$ref": "#/definitions/positiveInt32"},
    "POST_PLOT_J": {"$ref": "#/definitions/switch"},
    "POST_PLOT_QE": {"$ref": "#/definitions/switch"},
    "POST_PLOT_VE": {"$ref": "#/definitions/switch"},
    "POST_PLOT_M": {"$ref": "#/definitions/switch"},
    "POST_PLOT_QM": {"$ref": "#/definitions/switch"},
    "POST_PLOT_VM": {"$ref": "#/definitions/switch"},
    "POST_FIELD": {"$ref": "#/definitions/switch"},
    "POST_FIELD_ER": false
  },
  "anyOf": [
    {"required": ["N_FP"]},
    {"required": ["PRECISION"], "properties": {"PRECISION": {"$ref": "#/definitions/positive"}}}
  ],
  "definitions": {
    "numericToken": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
      "description": "Exact decimal/scientific token. Runtime enforces the field's bounds and integer requirements without float rounding."
    },
    "frequency": {
      "anyOf": [{"type": "integer", "minimum": 1, "maximum": 9223372036854775807}, {"$ref": "#/definitions/numericToken"}]
    },
    "positiveInt32": {
      "anyOf": [{"type": "integer", "minimum": 1, "maximum": 2147483647}, {"$ref": "#/definitions/numericToken"}]
    },
    "positive": {
      "anyOf": [{"type": "number", "exclusiveMinimum": 0}, {"$ref": "#/definitions/numericToken"}]
    },
    "nonnegative": {
      "anyOf": [{"type": "number", "minimum": 0}, {"$ref": "#/definitions/numericToken"}]
    },
    "switch": {
      "anyOf": [{"type": "integer", "minimum": 0, "maximum": 1}, {"type": "boolean"}, {"$ref": "#/definitions/numericToken"}]
    }
  }
}
