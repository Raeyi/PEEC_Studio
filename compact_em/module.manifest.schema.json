{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://peec-studio.local/schemas/module-manifest.schema.json",
  "title": "PEEC Studio Module Manifest",
  "description": "Self-describing contract for compute-layer modules. See docs/MODULE_MANIFEST_SPEC.md v1.1.",
  "type": "object",
  "required": ["manifestVersion", "id", "name", "version", "apiVersion", "cli", "stages", "artifacts", "dependsOn", "capabilities"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "providerId, must equal package directory name" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1, "description": "delivery batch version (human-readable)" },
    "apiVersion": { "type": "integer", "minimum": 1 },
    "minApiVersion": { "type": "integer", "minimum": 1, "default": 1 },
    "maxApiVersion": { "type": "integer", "minimum": 1, "description": "optional hard upper bound for compatibility window" },
    "cli": {
      "type": "object",
      "required": ["executables"],
      "properties": {
        "executables": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "dataRootArg": { "type": "string", "description": "R1 data-root parameter name (e.g. --data-root); omit if using scattered args via argsTemplate" },
        "deprecatedModes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "executable", "argsTemplate", "exitCodes", "errorContract"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "executable": { "type": "string" },
          "argsTemplate": { "type": "array", "items": { "type": "string" } },
          "allowedArgs": { "type": "array", "items": { "type": "string", "pattern": "^--" } },
          "optional": { "type": "boolean", "default": false },
          "exitCodes": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": { "type": "string" },
            "required": ["0"]
          },
          "errorContract": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["none", "qs-json-stderr"] },
              "traceLog": { "type": "string", "description": "template with {trace_id} placeholder" }
            }
          },
          "consumesInternal": { "type": "array", "items": { "type": "string" } },
          "producesInternal": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["produced", "consumed"],
      "properties": {
        "produced": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "path"],
            "properties": {
              "ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]*/[a-z][a-z0-9_.]*$" },
              "path": { "type": "string", "pattern": "^Result/" },
              "schemaVersion": { "type": "string" },
              "units": { "type": "object" },
              "publishTo": { "type": "string", "pattern": "^(Model|Setting)/" }
            }
          }
        },
        "consumed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "path"],
            "properties": {
              "ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]*/[a-z][a-z0-9_.]*$" },
              "path": { "type": "string" },
              "accept": { "type": "object" },
              "defaultTemplate": { "type": "string", "description": "deprecated in v1.2: templates/ no longer ships in the package; accepted only for legacy manifests" },
              "maintainedBy": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "dependsOn": {
      "type": "object",
      "required": ["artifacts"],
      "properties": {
        "modules": { "type": "array", "items": { "type": "string" } },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "environment": { "type": "object" }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["dataLayout"],
      "properties": {
        "dataLayout": { "type": "string", "pattern": "^peec-data/v[0-9]+$" },
        "breakingChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["version", "note"],
            "properties": {
              "version": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    }
  }
}