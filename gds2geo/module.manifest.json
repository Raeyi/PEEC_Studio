{
  "manifestVersion": 1,
  "id": "gds2geo",
  "name": "GDS2GEO",
  "version": "V1.1",
  "apiVersion": 1,
  "cli": {
    "executables": [
      "gds2geo.exe",
      "geo_prepare.exe",
      "geo2em.exe",
      "geo2thermal.exe"
    ],
    "deprecatedModes": [
      "no-arg-default",
      "exe-relative-fallback",
      "exe-relative-settings"
    ]
  },
  "stages": [
    {
      "id": "source",
      "executable": "gds2geo.exe",
      "argsTemplate": [
        "--runtime-dir",
        "{runtimeDir}",
        "source",
        "--gds",
        "{dataRoot}/Model/model.gds",
        "--tech",
        "{dataRoot}/Model/model_info.csv",
        "--output-dir",
        "{dataRoot}/Result/gds2geo/source"
      ],
      "allowedArgs": [
        "--top-cell"
      ],
      "optional": false,
      "exitCodes": {
        "0": "ok",
        "2": "input_or_config",
        "5": "execution",
        "6": "internal"
      },
      "errorContract": {
        "type": "none"
      },
      "consumesInternal": [],
      "producesInternal": [
        "gds2geo/source.geo",
        "gds2geo/source.json",
        "gds2geo/source.matdb"
      ]
    },
    {
      "id": "prepared",
      "executable": "geo_prepare.exe",
      "argsTemplate": [
        "--runtime-dir",
        "{runtimeDir}",
        "--input-dir",
        "{dataRoot}/Result/gds2geo/source",
        "--output-dir",
        "{dataRoot}/Result/gds2geo/prepared"
      ],
      "allowedArgs": [],
      "optional": false,
      "exitCodes": {
        "0": "ok",
        "2": "input_or_config",
        "5": "execution"
      },
      "errorContract": {
        "type": "none"
      },
      "consumesInternal": [
        "gds2geo/source.geo",
        "gds2geo/source.json",
        "gds2geo/source.matdb"
      ],
      "producesInternal": [
        "gds2geo/prepared.em.geo",
        "gds2geo/prepared.em.json",
        "gds2geo/prepared.thermal.geo",
        "gds2geo/prepared.thermal.json",
        "gds2geo/prepared.matdb"
      ]
    },
    {
      "id": "em",
      "executable": "geo2em.exe",
      "argsTemplate": [
        "--runtime-dir",
        "{runtimeDir}",
        "--input-dir",
        "{dataRoot}/Result/gds2geo/prepared",
        "--output-dir",
        "{dataRoot}/Result/gds2geo/em"
      ],
      "allowedArgs": [],
      "optional": false,
      "exitCodes": {
        "0": "ok",
        "2": "input_or_config",
        "5": "execution"
      },
      "errorContract": {
        "type": "none"
      },
      "consumesInternal": [
        "gds2geo/prepared.em.geo",
        "gds2geo/prepared.em.json",
        "gds2geo/prepared.matdb"
      ],
      "producesInternal": [
        "gds2geo/em.mesh",
        "gds2geo/em.receipt",
        "gds2geo/em.matdb"
      ]
    },
    {
      "id": "thermal",
      "executable": "geo2thermal.exe",
      "argsTemplate": [
        "--runtime-dir",
        "{runtimeDir}",
        "--input-dir",
        "{dataRoot}/Result/gds2geo/prepared",
        "--output-dir",
        "{dataRoot}/Result/gds2geo/thermal"
      ],
      "allowedArgs": [],
      "optional": false,
      "exitCodes": {
        "0": "ok",
        "2": "input_or_config",
        "5": "execution"
      },
      "errorContract": {
        "type": "none"
      },
      "consumesInternal": [
        "gds2geo/prepared.thermal.geo",
        "gds2geo/prepared.thermal.json",
        "gds2geo/prepared.matdb"
      ],
      "producesInternal": [
        "gds2geo/thermal.mesh",
        "gds2geo/thermal.receipt",
        "gds2geo/thermal.matdb"
      ]
    }
  ],
  "artifacts": {
    "produced": [
      {
        "ref": "gds2geo/mesh.em",
        "path": "Result/gds2geo/em/model_em.msh",
        "schemaVersion": "4",
        "units": {
          "length": "mm"
        },
        "publishTo": "Model/model_em.msh"
      },
      {
        "ref": "gds2geo/matdb.model",
        "path": "Result/gds2geo/em/matdb.json",
        "schemaVersion": "3",
        "publishTo": "Model/matdb.json"
      },
      {
        "ref": "gds2geo/receipt.em",
        "path": "Result/gds2geo/em/model_em.msh.json",
        "schemaVersion": "6"
      },
      {
        "ref": "gds2geo/mesh.thermal",
        "path": "Result/gds2geo/thermal/model_thermal.msh",
        "schemaVersion": "4",
        "units": {
          "length": "mm"
        }
      },
      {
        "ref": "gds2geo/matdb.thermal",
        "path": "Result/gds2geo/thermal/matdb.json",
        "schemaVersion": "3"
      },
      {
        "ref": "gds2geo/receipt.thermal",
        "path": "Result/gds2geo/thermal/model_thermal.msh.json",
        "schemaVersion": "6"
      }
    ],
    "consumed": [
      {
        "ref": "user/layout.gds",
        "path": "Model/model.gds",
        "accept": {
          "extensions": [
            ".gds"
          ]
        }
      },
      {
        "ref": "user/techfile",
        "path": "Model/model_info.csv",
        "accept": {
          "extensions": [
            ".csv"
          ]
        }
      }
    ]
  },
  "dependsOn": {
    "modules": [],
    "artifacts": [
      "user/layout.gds",
      "user/techfile"
    ],
    "environment": {
      "gmsh": {
        "version": "4.11.1",
        "requiredBy": [
          "em",
          "thermal"
        ]
      }
    }
  },
  "capabilities": {
    "dataLayout": "peec-data/v1",
    "breakingChanges": [],
    "technologyFormats": [
      "csv"
    ],
    "requiredStages": [
      "source",
      "prepared",
      "em",
      "thermal"
    ],
    "meshFormat": "4.1 ASCII",
    "meshSchemaVersionMeaning": "MSH major format version; not the mesh receipt schemaVersion",
    "materialSchemaVersion": 3,
    "meshReceiptSchemaVersion": 6,
    "lockMechanism": "Windows named mutex; no lock files",
    "externalDependencies": {
      "gmsh": {
        "version": "4.11.1",
        "bundled": true,
        "configuration": [
          "gmsh.exe beside the four stage executables (preferred)",
          "GDS2GEO_GMSH_EXECUTABLE absolute path",
          "PATH"
        ],
        "requiredBy": [
          "em",
          "thermal"
        ]
      }
    },
    "deliveryFiles": [
      "gds2geo.exe",
      "geo_prepare.exe",
      "geo2em.exe",
      "geo2thermal.exe",
      "gmsh.exe",
      "README.md",
      "ERROR_CODES.md",
      "module.manifest.json"
    ]
  }
}
