{
  "manifestVersion": 1,
  "id": "thermal",
  "name": "薄层与四面体混合热路提取及温度后处理",
  "version": "2026.11.02-native-1.0.1",
  "apiVersion": 2,
  "minApiVersion": 1,
  "cli": {
    "executables": [
      "ThermalExtract.exe",
      "TemperatureProcess.exe"
    ],
    "dataRootArg": "--data-root",
    "deprecatedModes": []
  },
  "stages": [
    {
      "id": "extract",
      "executable": "ThermalExtract.exe",
      "argsTemplate": [
        "--data-root",
        "{dataRoot}",
        "--runtime-dir",
        "{runtimeDir}",
        "--mesh",
        "{artifact:user/thermal.mesh}",
        "--materials",
        "{artifact:user/thermal.materials}",
        "--settings",
        "{artifact:user/solver.set}",
        "--source",
        "{artifact:thermal/source.def}"
      ],
      "allowedArgs": [
        "--mesh",
        "--materials",
        "--settings",
        "--source"
      ],
      "optional": false,
      "exitCodes": {
        "0": "ok",
        "2": "input_or_configuration",
        "3": "file_io",
        "4": "numerical_validation",
        "5": "runtime_services",
        "6": "pipeline_locked"
      },
      "errorContract": {
        "type": "qs-json-stderr"
      },
      "producesInternal": [
        "thermal/temperature.map",
        "thermal/extraction.binding",
        "thermal/operator.matrix",
        "thermal/node.table"
      ]
    },
    {
      "id": "post",
      "executable": "TemperatureProcess.exe",
      "argsTemplate": [
        "--data-root",
        "{dataRoot}",
        "--runtime-dir",
        "{runtimeDir}",
        "--mesh",
        "{artifact:user/thermal.mesh}",
        "--materials",
        "{artifact:user/thermal.materials}",
        "--settings",
        "{artifact:user/solver.set}",
        "--source",
        "{artifact:thermal/source.def}",
        "--op0",
        "{dataRoot}/Model/thermal.op0",
        "--result-binding",
        "{dataRoot}/Model/thermal_run.json"
      ],
      "allowedArgs": [
        "--mesh",
        "--materials",
        "--settings",
        "--source",
        "--op0",
        "--result-binding"
      ],
      "optional": true,
      "exitCodes": {
        "0": "ok",
        "2": "input_or_configuration",
        "3": "file_io",
        "4": "numerical_validation",
        "5": "runtime_services",
        "6": "pipeline_locked"
      },
      "errorContract": {
        "type": "qs-json-stderr"
      },
      "consumesInternal": [
        "thermal/temperature.map",
        "thermal/extraction.binding"
      ],
      "producesInternal": [
        "thermal/post.binding",
        "thermal/post.report"
      ]
    }
  ],
  "artifacts": {
    "produced": [
      {
        "ref": "thermal/netlist.dc",
        "path": "Result/thermal/extract/ThermalNetList.sp",
        "schemaVersion": "1"
      },
      {
        "ref": "thermal/netlist.rc",
        "path": "Result/thermal/extract/ThermalNetList_RC.sp",
        "schemaVersion": "1"
      },
      {
        "ref": "thermal/extract.report",
        "path": "Result/thermal/extract/extraction_report.json",
        "schemaVersion": "1"
      },
      {
        "ref": "thermal/temperature.nodes",
        "path": "Result/thermal/post/NodeTemperatureAtOperatingPoint.csv",
        "schemaVersion": "1"
      },
      {
        "ref": "thermal/temperature.mesh",
        "path": "Result/thermal/post/VolumeTemperatureAtOperatingPoint.msh",
        "schemaVersion": "4.1"
      },
      {
        "ref": "thermal/temperature.maximum",
        "path": "Result/thermal/post/MaximumTemperature.txt",
        "schemaVersion": "1"
      }
    ],
    "consumed": [
      {
        "ref": "user/thermal.mesh",
        "path": "Model/model_thermal.msh",
        "accept": {
          "extensions": [
            ".msh"
          ]
        }
      },
      {
        "ref": "user/thermal.materials",
        "path": "Model/matdb.json",
        "accept": {
          "schemaVersion": {
            "min": 3,
            "max": 3
          }
        }
      },
      {
        "ref": "user/solver.set",
        "path": "Setting/set.json",
        "accept": {
          "schemaVersion": {
            "min": 1,
            "max": 1
          }
        }
      },
      {
        "ref": "thermal/source.def",
        "path": "Model/source_thermal.json",
        "maintainedBy": [
          "ui"
        ],
        "accept": {
          "schemaVersion": {
            "min": 1,
            "max": 1
          },
          "fields": [
            "meshFile",
            "meshSha256",
            "sources",
            "fixed_temperature"
          ]
        }
      }
    ]
  },
  "dependsOn": {
    "modules": [],
    "artifacts": [
      "user/thermal.mesh",
      "user/thermal.materials",
      "user/solver.set",
      "thermal/source.def"
    ]
  },
  "capabilities": {
    "dataLayout": "peec-data/v1",
    "breakingChanges": [
      {
        "version": "2026.11.02-native-1.0.1",
        "note": "docs_1.2: source_thermal.json and thermal/source.def replace former port input; CLI --source replaces --ports. Module-only package; cases delivered separately."
      }
    ],
    "dataLayoutRevision": "1.2"
  }
}
