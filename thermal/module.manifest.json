{
  "manifestVersion": 1,
  "id": "thermal",
  "name": "热路提取及温度后处理",
  "version": "2026.11.06-native-1.0.7",
  "apiVersion": 7,
  "minApiVersion": 1,
  "cli": {
    "executables": [
      "ThermalExtract.exe",
      "TemperatureProcess.exe"
    ],
    "dataRootArg": "--data-root",
    "deprecatedModes": []
  },
  "stages": [
    {
      "id": "extract",
      "executable": "ThermalExtract.exe",
      "argsTemplate": [
        "--data-root",
        "{dataRoot}",
        "--runtime-dir",
        "{runtimeDir}",
        "--mesh",
        "{artifact:user/thermal.mesh}",
        "--materials",
        "{artifact:user/thermal.materials}",
        "--source",
        "{artifact:thermal/source.def}",
        "--boundary",
        "{artifact:thermal/boundary.def}",
        "--simulation-settings",
        "{artifact:user/thermal.simulation_settings}"
      ],
      "allowedArgs": [
        "--mesh",
        "--materials",
        "--source",
        "--boundary",
        "--simulation-settings"
      ],
      "optional": false,
      "exitCodes": {
        "0": "ok",
        "2": "input_or_configuration",
        "3": "file_io",
        "4": "numerical_validation",
        "5": "runtime_services",
        "6": "pipeline_locked"
      },
      "errorContract": {
        "type": "qs-json-stderr"
      },
      "producesInternal": [
        "thermal/temperature.map",
        "thermal/extraction.binding",
        "thermal/operator.matrix",
        "thermal/node.table"
      ]
    },
    {
      "id": "post",
      "executable": "TemperatureProcess.exe",
      "argsTemplate": [
        "--data-root",
        "{dataRoot}",
        "--runtime-dir",
        "{runtimeDir}",
        "--mesh",
        "{artifact:user/thermal.mesh}",
        "--materials",
        "{artifact:user/thermal.materials}",
        "--source",
        "{artifact:thermal/source.def}",
        "--op0",
        "{dataRoot}/Model/thermal.op0",
        "--boundary",
        "{artifact:thermal/boundary.def}",
        "--simulation-settings",
        "{artifact:user/thermal.simulation_settings}"
      ],
      "allowedArgs": [
        "--mesh",
        "--materials",
        "--source",
        "--op0",
        "--boundary",
        "--simulation-settings"
      ],
      "optional": true,
      "exitCodes": {
        "0": "ok",
        "2": "input_or_configuration",
        "3": "file_io",
        "4": "numerical_validation",
        "5": "runtime_services",
        "6": "pipeline_locked"
      },
      "errorContract": {
        "type": "qs-json-stderr"
      },
      "consumesInternal": [
        "thermal/temperature.map",
        "thermal/extraction.binding"
      ],
      "producesInternal": [
        "thermal/post.binding"
      ]
    }
  ],
  "artifacts": {
    "produced": [
      {
        "ref": "thermal/netlist.dc",
        "path": "Result/thermal/extract/ThermalNetList.sp",
        "schemaVersion": "1"
      },
      {
        "ref": "thermal/netlist.rc",
        "path": "Result/thermal/extract/ThermalNetList_RC.sp",
        "schemaVersion": "1"
      },
      {
        "ref": "thermal/extract.report",
        "path": "Result/thermal/extract/extraction_report.json",
        "schemaVersion": "1"
      },
      {
        "ref": "thermal/temperature.nodes",
        "path": "Result/thermal/post/NodeTemperatureAtOperatingPoint.csv",
        "schemaVersion": "1"
      },
      {
        "ref": "thermal/temperature.mesh",
        "path": "Result/thermal/post/VolumeTemperatureAtOperatingPoint.msh",
        "schemaVersion": "4.1"
      },
      {
        "ref": "thermal/temperature.maximum",
        "path": "Result/thermal/post/MaximumTemperature.txt",
        "schemaVersion": "1"
      },
      {
        "ref": "thermal/temperature.report",
        "path": "Result/thermal/post/TemperatureProcessReport.txt",
        "schemaVersion": "1"
      }
    ],
    "consumed": [
      {
        "ref": "user/thermal.mesh",
        "path": "Model/model_thermal.msh",
        "accept": {
          "extensions": [
            ".msh"
          ]
        }
      },
      {
        "ref": "user/thermal.materials",
        "path": "Model/matdb.json",
        "accept": {
          "schemaVersion": {
            "min": 3,
            "max": 3
          }
        }
      },
      {
        "ref": "thermal/source.def",
        "path": "Model/source_thermal.json",
        "maintainedBy": [
          "ui"
        ],
        "accept": {
          "schemaVersion": {
            "min": 2,
            "max": 3
          },
          "fields": [
            "sources"
          ]
        }
      },
      {
        "ref": "thermal/boundary.def",
        "path": "Model/boundary_thermal.json",
        "maintainedBy": [
          "ui"
        ],
        "accept": {
          "schemaVersion": {
            "min": 1,
            "max": 2
          }
        }
      },
      {
        "ref": "user/thermal.simulation_settings",
        "path": "Setting/set_thermal.json",
        "maintainedBy": [
          "ui"
        ],
        "accept": {
          "schemaVersion": {
            "min": 1,
            "max": 1
          }
        }
      }
    ]
  },
  "dependsOn": {
    "modules": [],
    "artifacts": [
      "user/thermal.mesh",
      "user/thermal.materials",
      "thermal/source.def",
      "thermal/boundary.def",
      "user/thermal.simulation_settings"
    ]
  },
  "capabilities": {
    "dataLayout": "peec-data/v1",
    "breakingChanges": [
      {
        "version": "2026.11.02-native-1.0.1",
        "note": "docs_1.2: source_thermal.json and thermal/source.def replace former port input; CLI --source replaces --ports. Module-only package; cases delivered separately."
      },
      {
        "version": "2026.11.02-native-1.0.2",
        "note": "Boundary configuration moved from source_thermal.json to required boundary_thermal.json; new --boundary CLI and thermal/boundary.def dependency. Internal extraction binding now includes boundary SHA256. TemperatureProcessReport.txt promoted to public artifact thermal/temperature.report."
      },
      {
        "version": "2026.11.02-native-1.0.3",
        "note": "User-requested removal of thermal_run.json and --result-binding. Default OP0 path is temporarily Result/thermal/post/thermal.op0. Node/mapping and extraction consistency checks retained; OP0-to-deck provenance is not verified."
      },
      {
        "version": "2026.11.02-native-1.0.4",
        "note": "Superseded: extraction control was incorrectly named set_thermal in 1.0.4; corrected in 1.0.5."
      },
      {
        "version": "2026.11.02-native-1.0.5",
        "note": "Setting/set_thermal.json contains SPICE simulation settings. Extraction control is temporarily Result/thermal/thermal_extract_control.json. --simulation-settings controls the op/probe directives; --settings continues to select extraction control."
      },
      {
        "version": "2026.11.04-native-1.0.6",
        "note": "DATA_LAYOUT 1.5: source_thermal.json schemaVersion 2 embeds required thermal extraction data; independent control file and --settings removed. OP0 binary default follows the actual source directory; standard manifest passes Model/thermal.op0. Post no longer reads or checks netlists; OP0 values required by the temperature map remain validated. Simulation settings schema/defaults unchanged; platform owns defaults."
      },
      {
        "version": "2026.11.06-native-1.0.7",
        "note": "Accept simplified source schema 3 and boundary schema 2 in addition to legacy 2/1; volume total power, arbitrary surface Dirichlet and convection; post accepts matching new source and preserves strict mapped-node checks."
      }
    ],
    "dataLayoutRevision": "1.5"
  }
}
