{
  "schemaVersion": 2,
  "_comment": "v2 = 路由表：契约来自各包 module.manifest.json（docs/MODULE_MANIFEST_SPEC.md）。kind: external/dll；provider = manifest id = 模块包目录名；stage = manifest stages[].id。gds2geo r2（V1.2-20261107-r2，2026-11-09 集成）：4 EXE → 2 EXE（gds2geo.exe / geo2msh.exe），stage 集 = em_geo / thermal_geo / em_msh / thermal_msh；gmsh 仅 em_msh/thermal_msh 需要（requiredBy）。",
  "modules": {
    "peec.model_extract": {
      "displayName": "等效电路模型 · PEEC 提取",
      "kind": "external",
      "provider": "compact_em",
      "stage": "extract",
      "searchDirs": [
        "{MODULE_ROOT}/compact_em"
      ]
    },
    "peec.solver": {
      "displayName": "等效电路模型 · 频域求解",
      "kind": "external",
      "provider": "compact_em",
      "stage": "solve",
      "searchDirs": [
        "{MODULE_ROOT}/compact_em"
      ]
    },
    "peec.post": {
      "displayName": "等效电路模型 · 源/场后处理",
      "kind": "external",
      "provider": "compact_em",
      "stage": "post",
      "searchDirs": [
        "{MODULE_ROOT}/compact_em"
      ]
    },
    "gds.geo_em": {
      "displayName": "电磁几何生成（GDS2GEO r2）",
      "kind": "external",
      "provider": "gds2geo",
      "stage": "em_geo",
      "searchDirs": [
        "{MODULE_ROOT}/gds2geo"
      ]
    },
    "gds.geo_thermal": {
      "displayName": "热学几何生成（GDS2GEO r2）",
      "kind": "external",
      "provider": "gds2geo",
      "stage": "thermal_geo",
      "searchDirs": [
        "{MODULE_ROOT}/gds2geo"
      ]
    },
    "gds.mesh_em": {
      "displayName": "电磁网格生成（GDS2GEO r2）",
      "kind": "external",
      "provider": "gds2geo",
      "stage": "em_msh",
      "env": {
        "GDS2GEO_GMSH_EXECUTABLE": "{MODULE_ROOT}/tools/gmsh/gmsh.exe"
      },
      "searchDirs": [
        "{MODULE_ROOT}/gds2geo"
      ]
    },
    "gds.mesh_thermal": {
      "displayName": "热网格生成（1102 起必需）",
      "kind": "external",
      "provider": "gds2geo",
      "stage": "thermal_msh",
      "env": {
        "GDS2GEO_GMSH_EXECUTABLE": "{MODULE_ROOT}/tools/gmsh/gmsh.exe"
      },
      "searchDirs": [
        "{MODULE_ROOT}/gds2geo"
      ]
    },
    "thermal.extract": {
      "displayName": "热路提取（薄层/四面体混合）",
      "kind": "external",
      "provider": "thermal",
      "stage": "extract",
      "searchDirs": [
        "{MODULE_ROOT}/thermal"
      ]
    },
    "thermal.post": {
      "displayName": "温度后处理（OP0 映射，可选）",
      "kind": "external",
      "provider": "thermal",
      "stage": "post",
      "searchDirs": [
        "{MODULE_ROOT}/thermal"
      ]
    },
    "sim.solver": {
      "displayName": "仿真求解（MNA/ALPS，待接入）",
      "kind": "dll",
      "provider": "sim_solver",
      "stage": "solve",
      "searchDirs": [
        "{BIN}/modules/sim_solver"
      ],
      "workerHost": "{BIN}/worker_host.exe"
    },
    "opt.optimizer": {
      "displayName": "优化计算（伴随灵敏度，待接入）",
      "kind": "dll",
      "provider": "opt_optimizer",
      "stage": "optimize",
      "searchDirs": [
        "{BIN}/modules/opt_optimizer"
      ],
      "workerHost": "{BIN}/worker_host.exe"
    },
    "post.engine": {
      "displayName": "后处理（场计算/反演导出，待接入）",
      "kind": "dll",
      "provider": "post_engine",
      "stage": "process",
      "searchDirs": [
        "{BIN}/modules/post_engine"
      ],
      "workerHost": "{BIN}/worker_host.exe"
    }
  }
}
