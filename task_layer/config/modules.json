{
  "schemaVersion": 2,
  "_comment": "v2 = 路由表：契约来自各包 module.manifest.json（docs/MODULE_MANIFEST_SPEC.md）。kind: external/dll；provider = manifest id = 模块包目录名；stage = manifest stages[].id。",
  "modules": {
    "peec.model_extract": {
      "displayName": "等效电路模型 · PEEC 提取",
      "kind": "external",
      "provider": "compact_em",
      "stage": "extract",
      "searchDirs": ["{MODULE_ROOT}/compact_em"]
    },
    "peec.solver": {
      "displayName": "等效电路模型 · 频域求解",
      "kind": "external",
      "provider": "compact_em",
      "stage": "solve",
      "searchDirs": ["{MODULE_ROOT}/compact_em"]
    },
    "peec.plotter": {
      "displayName": "等效电路模型 · S 参数绘图",
      "kind": "external",
      "provider": "compact_em",
      "stage": "plot",
      "searchDirs": ["{MODULE_ROOT}/compact_em"]
    },
    "peec.post": {
      "displayName": "等效电路模型 · 源/场后处理",
      "kind": "external",
      "provider": "compact_em",
      "stage": "post",
      "searchDirs": ["{MODULE_ROOT}/compact_em"]
    },
    "phys.model_parse": {
      "displayName": "物理模型解析（GDS2GEO 源模型）",
      "kind": "external",
      "provider": "gds2geo",
      "stage": "source",
      "searchDirs": ["{MODULE_ROOT}/gds2geo"]
    },
    "gds.prepare": {
      "displayName": "几何准备（热/电磁目标派生）",
      "kind": "external",
      "provider": "gds2geo",
      "stage": "prepare",
      "searchDirs": ["{MODULE_ROOT}/gds2geo"]
    },
    "gds.mesh_em": {
      "displayName": "电磁网格生成",
      "kind": "external",
      "provider": "gds2geo",
      "stage": "mesh_em",
      "searchDirs": ["{MODULE_ROOT}/gds2geo"]
    },
    "gds.mesh_thermal": {
      "displayName": "热网格生成（可选）",
      "kind": "external",
      "provider": "gds2geo",
      "stage": "mesh_thermal",
      "searchDirs": ["{MODULE_ROOT}/gds2geo"]
    },
    "sim.solver": {
      "displayName": "仿真求解（MNA/ALPS，待接入）",
      "kind": "dll",
      "provider": "sim_solver",
      "stage": "solve",
      "searchDirs": ["{BIN}/modules/sim_solver"],
      "workerHost": "{BIN}/worker_host.exe"
    },
    "opt.optimizer": {
      "displayName": "优化计算（伴随灵敏度，待接入）",
      "kind": "dll",
      "provider": "opt_optimizer",
      "stage": "optimize",
      "searchDirs": ["{BIN}/modules/opt_optimizer"],
      "workerHost": "{BIN}/worker_host.exe"
    },
    "post.engine": {
      "displayName": "后处理（场计算/反演导出，待接入）",
      "kind": "dll",
      "provider": "post_engine",
      "stage": "process",
      "searchDirs": ["{BIN}/modules/post_engine"],
      "workerHost": "{BIN}/worker_host.exe"
    }
  }
}
