{
  "schemaVersion": 2,
  "_comment": "v2 = 路由表：契约来自各包 module.manifest.json（docs/MODULE_MANIFEST_SPEC.md）。kind: external/dll；provider = manifest id = 模块包目录名；stage = manifest stages[].id。gds2geo r2（V1.2-20261107-r2，2026-11-09 集成）：4 EXE → 2 EXE（gds2geo.exe / geo2msh.exe），stage 集 = em_geo / thermal_geo / em_msh / thermal_msh；compact_em 2026.11.10-v1.4（apiVersion 4，2026-11-12 集成）：后处理合并，extract/solve/post 的 CLI 与产物以 manifest 为准；solve 新产 Y/Z 参数 CSV；errorContract 转 none。gds2geo 1.3.0（apiVersion 5，2026-11-12 集成）：4 主阶段与 CLI/产物路径不变；新增辅助 EXE geoedit/mshcheck/mshfix（不在流水线 DAG，见 manifest capabilities.auxiliaryCommands）；gmsh 4.11.1 共享：GDS2GEO_GMSH_EXECUTABLE 指 gmsh.exe，gmsh-4.11.dll 为 mshfix 直接 PE 依赖（tools/gmsh/）。alpsrunner 1.1.2（apiVersion 1，2026-11-12 集成）：热网表经 SSH 在远端 IC618 Linux 虚拟机求解（ALPS 2025）并回传结果集；模块包置于 tools/alpsrunner（与 gmsh 同处共享工具目录）；artifacts.produced=[]、无固定 OP0、无 publishTo（OP0 导入由平台承担，见 task_layer/ERROR_CODES.md §2.8）；环境依赖 alpsrunner_host 为 bundled=false 远端主机（不随包分发）；--threads 用 {override:--threads} 令牌（平台 rebind 语义，见 docs/MODULE_MANIFEST_SPEC.md）。",
  "modules": {
    "peec.model_extract": {
      "displayName": "等效电路模型 · PEEC 提取",
      "kind": "external",
      "provider": "compact_em",
      "stage": "extract",
      "searchDirs": [
        "{MODULE_ROOT}/compact_em"
      ]
    },
    "peec.solver": {
      "displayName": "等效电路模型 · 频域求解",
      "kind": "external",
      "provider": "compact_em",
      "stage": "solve",
      "searchDirs": [
        "{MODULE_ROOT}/compact_em"
      ]
    },
    "peec.post": {
      "displayName": "等效电路模型 · 源/场后处理",
      "kind": "external",
      "provider": "compact_em",
      "stage": "post",
      "searchDirs": [
        "{MODULE_ROOT}/compact_em"
      ]
    },
    "gds.geo_em": {
      "displayName": "电磁几何生成",
      "kind": "external",
      "provider": "gds2geo",
      "stage": "em_geo",
      "searchDirs": [
        "{MODULE_ROOT}/gds2geo"
      ]
    },
    "gds.geo_thermal": {
      "displayName": "热学几何生成",
      "kind": "external",
      "provider": "gds2geo",
      "stage": "thermal_geo",
      "searchDirs": [
        "{MODULE_ROOT}/gds2geo"
      ]
    },
    "gds.mesh_em": {
      "displayName": "电磁网格生成",
      "kind": "external",
      "provider": "gds2geo",
      "stage": "em_msh",
      "env": {
        "GDS2GEO_GMSH_EXECUTABLE": "{MODULE_ROOT}/tools/gmsh/gmsh.exe"
      },
      "searchDirs": [
        "{MODULE_ROOT}/gds2geo"
      ]
    },
    "gds.mesh_thermal": {
      "displayName": "热网格生成",
      "kind": "external",
      "provider": "gds2geo",
      "stage": "thermal_msh",
      "env": {
        "GDS2GEO_GMSH_EXECUTABLE": "{MODULE_ROOT}/tools/gmsh/gmsh.exe"
      },
      "searchDirs": [
        "{MODULE_ROOT}/gds2geo"
      ]
    },
    "thermal.extract": {
      "displayName": "热路提取",
      "kind": "external",
      "provider": "thermal",
      "stage": "extract",
      "searchDirs": [
        "{MODULE_ROOT}/thermal"
      ]
    },
    "thermal.post": {
      "displayName": "温度后处理",
      "kind": "external",
      "provider": "thermal",
      "stage": "post",
      "searchDirs": [
        "{MODULE_ROOT}/thermal"
      ]
    },
    "alps.simulate": {
      "displayName": "ALPS 远程仿真",
      "kind": "external",
      "provider": "alpsrunner",
      "stage": "simulate",
      "searchDirs": [
        "{MODULE_ROOT}/tools/alpsrunner"
      ]
    },
    "sim.solver": {
      "displayName": "仿真求解",
      "kind": "dll",
      "provider": "sim_solver",
      "stage": "solve",
      "searchDirs": [
        "{BIN}/modules/sim_solver"
      ],
      "workerHost": "{BIN}/worker_host.exe"
    },
    "opt.optimizer": {
      "displayName": "优化计算",
      "kind": "dll",
      "provider": "opt_optimizer",
      "stage": "optimize",
      "searchDirs": [
        "{BIN}/modules/opt_optimizer"
      ],
      "workerHost": "{BIN}/worker_host.exe"
    },
    "post.engine": {
      "displayName": "后处理",
      "kind": "dll",
      "provider": "post_engine",
      "stage": "process",
      "searchDirs": [
        "{BIN}/modules/post_engine"
      ],
      "workerHost": "{BIN}/worker_host.exe"
    }
  }
