{
  "schemaVersion": 2,
  "_comment": "handoff 阶段已移除（v1.1 布局规范：正式件由 publisher 按 manifest publishTo 落位，见 docs/DATA_LAYOUT.md D3）。v2（P2）：顶层 stages = 阶段库（同一模块接线的库级默认：模块/参数/工件路由/前置/可选/闸门），pipeline 阶段经 ref 引用 + 本地覆盖（params/artifacts 键级合并本地赢；requires/optional 本地有则本地赢；userGate 本地只能 extends 新增键）。物化规则与 v1 等价性见 task_layer/README.md 变更记录（P2）",
  "stages": {
    "em.model_extract": {
      "module": "peec.model_extract",
      "name": "PEEC 模型提取"
    },
    "em.solver": {
      "module": "peec.solver",
      "name": "频域求解",
      "requires": [
        "Result/compact_em/extract/model.peec"
      ]
    },
    "em.post": {
      "module": "peec.post",
      "name": "源/场后处理",
      "optional": true,
      "requires": [
        "Result/compact_em/extract/model.peec",
        "Result/compact_em/solve/S_parameter.csv"
      ]
    },
    "em.source": {
      "module": "phys.model_parse",
      "name": "源模型解析（gds2geo）"
    },
    "em.prepare": {
      "module": "gds.prepare",
      "name": "几何准备",
      "requires": [
        "Result/gds2geo/source/model.geo"
      ]
    },
    "em.mesh": {
      "module": "gds.mesh_em",
      "name": "电磁网格",
      "requires": [
        "Result/gds2geo/prepared/em.geo"
      ]
    },
    "em.mesh_thermal": {
      "module": "gds.mesh_thermal",
      "name": "热网格（1102 起必需）",
      "requires": [
        "Result/gds2geo/prepared/thermal.geo"
      ]
    },
    "thermal.extract": {
      "module": "thermal.extract",
      "name": "热路提取",
      "artifacts": {
        "user/thermal.mesh": "Result/gds2geo/thermal/model_thermal.msh"
      }
    },
    "thermal.post": {
      "module": "thermal.post",
      "name": "温度后处理（OP0 映射）",
      "optional": true,
      "artifacts": {
        "user/thermal.mesh": "Result/gds2geo/thermal/model_thermal.msh"
      },
      "requires": [
        "Model/thermal.op0",
        "Result/thermal/extract/ThermalNetList.sp"
      ]
    }
  },
  "pipelines": {
    "peec_basic": {
      "displayName": "电磁基本链路（PEEC 三段）",
      "description": "网格/材料/端口校验 → P/L 提取 → 频域求解 → 源/场后处理（S 参数绘图由前端完成；plot 阶段 2026-11-04 起移除，绘图程序与 Touchstone 导出随 compact_em v1.3 一并取消，2026-11-05 起生效）",
      "maxParallel": 1,
      "stages": [
        {
          "id": "extract",
          "ref": "em.model_extract",
          "dependsOn": []
        },
        {
          "id": "solve",
          "ref": "em.solver",
          "dependsOn": [
            "extract"
          ]
        },
        {
          "id": "post",
          "ref": "em.post",
          "dependsOn": [
            "solve"
          ]
        }
      ]
    },
    "gds_full": {
      "displayName": "建模与网格（GDS2GEO 四阶段）",
      "description": "源模型生成 → 几何准备 → 电磁网格（热网格可选）；正式件（Model/ 主网格+matdb）由 publisher 按 manifest 落位",
      "maxParallel": 1,
      "stages": [
        {
          "id": "source",
          "ref": "em.source",
          "dependsOn": []
        },
        {
          "id": "prepared",
          "ref": "em.prepare",
          "dependsOn": [
            "source"
          ]
        },
        {
          "id": "em",
          "ref": "em.mesh",
          "dependsOn": [
            "prepared"
          ]
        },
        {
          "id": "thermal",
          "ref": "em.mesh_thermal",
          "dependsOn": [
            "prepared"
          ]
        }
      ]
    },
    "thermal_basic": {
      "displayName": "热基本链路（thermal 两段）",
      "description": "热路提取 → 温度后处理（可选）。热网格经 stage artifacts 路由到 gds2geo 热链产物（Result/gds2geo/thermal/），材料用 publisher 落位的 Model/matdb.json；UI 提供 Model/source_thermal.json（schemaVersion 2，含 thermal 提取对象：体域/薄层/材料关联）+ Model/boundary_thermal.json（必需）+ Setting/set_thermal.json（SPICE 仿真设置：analysis/probe）；post 依赖 Model/thermal.op0（ALPS 结果，1.0.6 起标准位置，1.0.5 时代的 Result/thermal/ 独立控制件已取消）",
      "maxParallel": 1,
      "stages": [
        {
          "id": "extract",
          "ref": "thermal.extract",
          "dependsOn": []
        },
        {
          "id": "post",
          "ref": "thermal.post",
          "dependsOn": [
            "extract"
          ]
        }
      ]
    }
  }
}
