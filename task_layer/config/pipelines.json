{
  "schemaVersion": 1,
  "_comment": "handoff 阶段已移除（v1.1 布局规范：正式件由 publisher 按 manifest publishTo 落位，见 docs/DATA_LAYOUT.md D3）",
  "pipelines": {
    "peec_basic": {
      "displayName": "电磁基本链路（PEEC 四段）",
      "description": "网格/材料/端口校验 → P/L 提取 → 频域求解 → S 参数绘图 + 源/场后处理",
      "maxParallel": 1,
      "stages": [
        { "id": "extract", "module": "peec.model_extract", "name": "PEEC 模型提取", "dependsOn": [] },
        { "id": "solve", "module": "peec.solver", "name": "频域求解", "dependsOn": ["extract"] },
        { "id": "plot", "module": "peec.plotter", "name": "S 参数绘图", "dependsOn": ["solve"], "optional": true },
        { "id": "post", "module": "peec.post", "name": "源/场后处理", "dependsOn": ["solve"], "optional": true }
      ]
    },
    "gds_full": {
      "displayName": "建模与网格（GDS2GEO 四阶段）",
      "description": "源模型生成 → 几何准备 → 电磁网格（热网格可选）；正式件（Model/ 主网格+matdb）由 publisher 按 manifest 落位",
      "maxParallel": 1,
      "stages": [
        { "id": "source", "module": "phys.model_parse", "name": "源模型解析（gds2geo）", "dependsOn": [] },
        { "id": "prepared", "module": "gds.prepare", "name": "几何准备", "dependsOn": ["source"] },
        { "id": "em", "module": "gds.mesh_em", "name": "电磁网格", "dependsOn": ["prepared"] },
        { "id": "thermal", "module": "gds.mesh_thermal", "name": "热网格（1102 起必需）", "dependsOn": ["prepared"] }
      ]
    },
    "thermal_basic": {
      "displayName": "热基本链路（thermal 两段）",
      "description": "热路提取 → 温度后处理（可选）。热网格经 stage artifacts 路由到 gds2geo 热链产物（Result/gds2geo/thermal/），材料用 publisher 落位的 Model/matdb.json；UI 提供 Model/source_thermal.json 与 Setting/set.json（含 thermal 对象）",
      "maxParallel": 1,
      "stages": [
        { "id": "extract", "module": "thermal.extract", "name": "热路提取", "dependsOn": [],
          "artifacts": { "user/thermal.mesh": "Result/gds2geo/thermal/model_thermal.msh" } },
        { "id": "post", "module": "thermal.post", "name": "温度后处理（OP0 映射）", "dependsOn": ["extract"], "optional": true,
          "artifacts": { "user/thermal.mesh": "Result/gds2geo/thermal/model_thermal.msh" },
          "requires": ["Model/thermal.op0", "Model/thermal_run.json"] }
      ]
    }
  }
}
