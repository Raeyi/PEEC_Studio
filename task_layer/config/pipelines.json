{
  "schemaVersion": 1,
  "_comment": "handoff 阶段已移除（v1.1 布局规范：正式件由 publisher 按 manifest publishTo 落位，见 docs/DATA_LAYOUT.md D3）",
  "pipelines": {
    "peec_basic": {
      "displayName": "电磁基本链路（PEEC 四段）",
      "description": "网格/材料/端口校验 → P/L 提取 → 频域求解 → S 参数绘图 + 源/场后处理",
      "maxParallel": 1,
      "stages": [
        { "id": "extract", "module": "peec.model_extract", "name": "PEEC 模型提取", "dependsOn": [] },
        { "id": "solve", "module": "peec.solver", "name": "频域求解", "dependsOn": ["extract"] },
        { "id": "plot", "module": "peec.plotter", "name": "S 参数绘图", "dependsOn": ["solve"], "optional": true },
        { "id": "post", "module": "peec.post", "name": "源/场后处理", "dependsOn": ["solve"], "optional": true }
      ]
    },
    "gds_full": {
      "displayName": "建模与网格（GDS2GEO 四阶段）",
      "description": "源模型生成 → 几何准备 → 电磁网格（热网格可选）；正式件（Model/ 主网格+matdb）由 publisher 按 manifest 落位",
      "maxParallel": 1,
      "stages": [
        { "id": "parse", "module": "phys.model_parse", "name": "物理模型解析（gds2geo）", "dependsOn": [] },
        { "id": "prepared", "module": "gds.prepare", "name": "几何准备", "dependsOn": ["parse"] },
        { "id": "em", "module": "gds.mesh_em", "name": "电磁网格", "dependsOn": ["prepared"] },
        { "id": "thermal", "module": "gds.mesh_thermal", "name": "热网格", "dependsOn": ["prepared"], "optional": true }
      ]
    },
    "thermal_te": {
      "displayName": "热路与热电耦合（预留）",
      "description": "热路提取 + 电热耦合（模块接入后启用）",
      "maxParallel": 1,
      "stages": [
        { "id": "thermal", "module": "peec.model_extract", "name": "热路提取（占位）", "dependsOn": [] }
      ]
    }
  }
}
